import { NextResponse } from 'next/server'
import { prisma } from '@/lib/prisma'
import { sign } from 'jsonwebtoken'

const JWT_SECRET = process.env.JWT_SECRET || 'your-secret-key'

export async function POST(request: Request) {
  try {
    const { phone, code, userType } = await request.json()
    
    if (!phone || !code || !userType) {
      return NextResponse.json(
        { error: 'Phone, code, and userType are required' },
        { status: 400 }
      )
    }

    // Clean phone number
    const cleanPhone = phone.replace(/\D/g, '')
    console.log('🔍 Verifying code:', { phone, cleanPhone, code, userType })

    // Find valid auth code
    const authCode = await prisma.authCode.findFirst({
      where: {
        phone: cleanPhone,
        code: code.toString(),
        userType,
        used: false,
        expiresAt: {
          gt: new Date(),
        },
      },
    })

    if (!authCode) {
      console.log('❌ Auth code not found or expired')
      return NextResponse.json(
        { error: 'Invalid or expired code' },
        { status: 401 }
      )
    }

    console.log('✅ Auth code found:', authCode.id)

    // Mark code as used
    await prisma.authCode.update({
      where: { id: authCode.id },
      data: { used: true },
    })

    let user = null
    let patient = null

    if (userType === 'DOCTOR' || userType === 'ADMIN') {
      // Find or create doctor/admin user
      // Try both formatted and unformatted phone numbers
      user = await prisma.user.findFirst({
        where: {
          OR: [
            { phone: cleanPhone },
            { phone: phone }, // original formatted phone
          ],
          role: {
            in: userType === 'DOCTOR' ? ['DOCTOR', 'OWNER'] : ['ADMIN', 'OWNER']
          },
        },
        include: {
          tenant: true,
        },
      })

      if (!user) {
        // For doctors/admins, they need to be pre-registered
        console.log('❌ User not found for phone:', cleanPhone, 'userType:', userType)
        return NextResponse.json(
          { error: 'User not found. Please contact administrator.' },
          { status: 404 }
        )
      }

      console.log('✅ User found:', user.firstName, user.lastName, user.role)
    } else if (userType === 'PATIENT') {
      // Find or create patient
      patient = await prisma.patient.findFirst({
        where: {
          phone: cleanPhone,
          isActive: true,
        },
        select: {
          id: true,
          name: true,
          phone: true,
          isActive: true,
        },
      })

      if (!patient) {
        // For patients, we can create them on first login
        // But we need a default tenant - in a real app, this would be determined differently
        const defaultTenant = await prisma.tenant.findFirst()
        
        if (!defaultTenant) {
          return NextResponse.json(
            { error: 'System not configured. Please contact administrator.' },
            { status: 500 }
          )
        }

        patient = await prisma.patient.create({
          data: {
            name: `Paciente ${cleanPhone}`, // Temporary name, can be updated later
            phone: cleanPhone,
            contactSource: 'MANUAL',
          },
          select: {
            id: true,
            name: true,
            phone: true,
            isActive: true,
          },
        })
      }
    }

    // Generate JWT token
    const tokenPayload = {
      id: user?.id || patient?.id,
      phone: cleanPhone,
      userType,
      tenantId: user?.tenantId || null,
      role: user?.role || 'PATIENT',
    }

    const token = sign(tokenPayload, JWT_SECRET, { expiresIn: '7d' })

    // Prepare response data
    const responseData = {
      token,
      user: user ? {
        id: user.id,
        firstName: user.firstName,
        lastName: user.lastName,
        email: user.email,
        phone: user.phone,
        role: user.role,
        tenantId: user.tenantId,
        tenant: {
          id: user.tenant.id,
          name: user.tenant.name,
          slug: user.tenant.slug,
        },
      } : null,
      patient: patient ? {
        id: patient.id,
        name: patient.name,
        phone: patient.phone,
      } : null,
      userType,
    }

    return NextResponse.json(responseData)
  } catch (error) {
    console.error('Error verifying auth code:', error)
    return NextResponse.json(
      { error: 'Failed to verify code' },
      { status: 500 }
    )
  }
}
